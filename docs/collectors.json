{
  "version": 1,
  "hook_services": [
    {
      "class": "SymPress\\Profiler\\Hook\\GatedHooksBootstrap",
      "role": "lifecycle",
      "collector_keys": ["*"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "register", "priority": -1000}
      ]
    },
    {
      "class": "SymPress\\Profiler\\Hook\\ProfilerRouteHooks",
      "role": "route",
      "collector_keys": [],
      "hooks": [
        {"hook": "init", "method": "handle", "priority": 0}
      ]
    },
    {
      "class": "SymPress\\Profiler\\Hook\\ProfilerHooks",
      "role": "lifecycle",
      "collector_keys": ["*"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "start", "priority": 25},
        {"hook": "template_include", "method": "captureTemplate", "type": "filter", "priority": 1000},
        {"hook": "template_redirect", "method": "beginFrontendBuffer", "priority": -1000},
        {"hook": "kernel.error", "method": "recordThrowable"},
        {"hook": "shutdown", "method": "finish", "priority": 999999}
      ],
      "tag": "profiler.hook"
    },
    {
      "class": "SymPress\\Profiler\\Recorder\\ProfilerLifecycleRecorder",
      "role": "recorder",
      "collector_keys": ["performance", "template"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "bootstrap", "priority": 30},
        {"hook": "plugins_loaded", "method": "mark"},
        {"hook": "setup_theme", "method": "mark"},
        {"hook": "after_setup_theme", "method": "mark"},
        {"hook": "init", "method": "mark"},
        {"hook": "wp_loaded", "method": "mark"},
        {"hook": "parse_request", "method": "mark", "accepted_args": 1},
        {"hook": "parse_query", "method": "mark", "accepted_args": 1},
        {"hook": "wp", "method": "mark", "accepted_args": 1},
        {"hook": "template_redirect", "method": "mark"},
        {"hook": "template_include", "method": "captureTemplate", "type": "filter", "priority": 999},
        {"hook": "shutdown", "method": "mark", "priority": 900000}
      ],
      "tag": "profiler.hook"
    },
    {
      "class": "SymPress\\Profiler\\Recorder\\ProfilerErrorRecorder",
      "role": "recorder",
      "collector_keys": ["exceptions", "logs"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "enable", "priority": 35},
        {"hook": "shutdown", "method": "captureShutdown", "priority": 950000}
      ],
      "tag": "profiler.hook"
    },
    {
      "class": "SymPress\\Profiler\\Recorder\\ProfilerHttpClientRecorder",
      "role": "recorder",
      "collector_keys": ["http_client"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "enable", "priority": 35},
        {"hook": "pre_http_request", "method": "track", "type": "filter", "accepted_args": 3},
        {"hook": "http_api_debug", "method": "record", "accepted_args": 5}
      ],
      "tag": "profiler.hook"
    },
    {
      "class": "SymPress\\Profiler\\Recorder\\ProfilerTemplateRecorder",
      "role": "recorder",
      "collector_keys": ["template"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "enable", "priority": 35},
        {"hook": "get_template_part", "method": "recordTemplatePart", "accepted_args": 4}
      ],
      "tag": "profiler.hook"
    },
    {
      "class": "SymPress\\Profiler\\Recorder\\ProfilerBlockRecorder",
      "role": "recorder",
      "collector_keys": ["blocks"],
      "hooks": [
        {"hook": "plugins_loaded", "method": "enable", "priority": 35},
        {"hook": "render_block_data", "method": "start", "type": "filter", "accepted_args": 3},
        {"hook": "render_block", "method": "finish", "type": "filter", "accepted_args": 3}
      ],
      "tag": "profiler.hook"
    }
  ],
  "external_filters": [
    {
      "hook": "sympress_profiler_log_entries",
      "producer": "sympress/monolog-bundle",
      "collector_key": "logs"
    }
  ],
  "collectors": [
    {
      "class": "SymPress\\Profiler\\Collector\\RequestCollector",
      "key": "request",
      "priority": 100,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["ProfileContext", "request superglobals", "current WordPress user"],
      "payload_keys": ["method", "uri", "url", "ip", "user_agent", "referer", "content_type", "context", "context_flags", "status_code", "status_text", "started_at", "finished_at", "duration_ms", "memory_mb", "peak_memory_mb", "template", "request_headers", "response_headers", "response_content_type", "query", "post", "cookies", "files", "server", "user", "throwables", "php_error"],
      "sensitive_fields": ["ip", "user_agent", "referer", "request_headers", "query", "post", "cookies", "files", "server", "user", "throwables", "php_error"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\PerformanceCollector",
      "key": "performance",
      "priority": 90,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["ProfilerLifecycleRecorder", "ProfilerStopwatch", "ProfileContext"],
      "payload_keys": ["total_duration_ms", "bootstrap_ms", "runtime_ms", "render_ms", "peak_memory_mb", "timeline", "stopwatch"],
      "sensitive_fields": []
    },
    {
      "class": "SymPress\\Profiler\\Collector\\ExceptionCollector",
      "key": "exceptions",
      "priority": 80,
      "views": {"toolbar": "none", "panel": true},
      "sources": ["ProfileContext throwables", "ProfilerErrorRecorder fatal error"],
      "payload_keys": ["count", "entries"],
      "sensitive_fields": ["entries.*.message", "entries.*.file"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\LogCollector",
      "key": "logs",
      "priority": 70,
      "views": {"toolbar": "none", "panel": true},
      "sources": ["ProfilerErrorRecorder", "sympress_profiler_log_entries filter"],
      "payload_keys": ["count", "counts", "channels", "entries"],
      "sensitive_fields": ["entries.*.message", "entries.*.file", "entries.*.context", "entries.*.extra"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\DatabaseCollector",
      "key": "database",
      "priority": 60,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["global wpdb", "SAVEQUERIES"],
      "payload_keys": ["enabled", "count", "total_duration_ms", "last_error", "queries", "slow_queries", "duplicate_queries", "caller_breakdown", "truncated", "captured_at"],
      "sensitive_fields": ["last_error", "queries", "slow_queries", "duplicate_queries", "caller_breakdown"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\LocalizationCollector",
      "key": "localization",
      "priority": 55,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["WordPress locale functions", "global l10n"],
      "payload_keys": ["locale", "fallback_locale", "is_rtl", "timezone", "loaded_domains", "domain_count", "captured_at"],
      "sensitive_fields": []
    },
    {
      "class": "SymPress\\Profiler\\Collector\\SecurityCollector",
      "key": "security",
      "priority": 52,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["WordPress authentication state", "request cookies"],
      "payload_keys": ["logged_in", "user", "has_auth_cookie", "ssl", "can_manage_options", "captured_at"],
      "sensitive_fields": ["user"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\HookCollector",
      "key": "hooks",
      "priority": 50,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["global wp_filter", "global wp_actions", "global wp_current_filter"],
      "payload_keys": ["fired_count", "registered_count", "top_hooks", "called_listeners", "fired_order", "current_stack", "captured_at"],
      "sensitive_fields": ["called_listeners"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\RoutingCollector",
      "key": "routing",
      "priority": 40,
      "views": {"toolbar": "none", "panel": true},
      "sources": ["global wp", "WordPress conditionals", "ProfileContext template"],
      "payload_keys": ["request", "matched_rule", "matched_query", "query_vars", "template", "queried_object", "conditionals", "rewrite"],
      "sensitive_fields": ["matched_query", "query_vars", "template", "queried_object"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\WordPressQueryCollector",
      "key": "wp_query",
      "priority": 38,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["global wp_query", "global wp", "WordPress query functions"],
      "payload_keys": ["request", "matched_rule", "matched_query", "query_vars", "request_sql", "post_count", "found_posts", "max_num_pages", "is_main_query", "queried_object", "conditionals", "posts", "pagination"],
      "sensitive_fields": ["matched_query", "query_vars", "request_sql", "queried_object", "posts"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\RestAjaxCollector",
      "key": "rest_ajax",
      "priority": 36,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["request state", "WordPress REST server"],
      "payload_keys": ["is_rest", "is_json", "is_ajax", "rest_route", "rest_namespace", "ajax_action", "method", "registered_routes"],
      "sensitive_fields": ["rest_route", "ajax_action", "registered_routes"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\TemplateCollector",
      "key": "template",
      "priority": 35,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["ProfileContext template", "ProfilerLifecycleRecorder", "ProfilerTemplateRecorder", "current theme"],
      "payload_keys": ["template", "template_name", "template_dir", "render_ms", "hierarchy", "template_parts", "theme", "captured_at"],
      "sensitive_fields": ["template", "template_dir", "hierarchy", "template_parts", "theme.theme_root"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\BlockCollector",
      "key": "blocks",
      "priority": 34,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["ProfilerBlockRecorder", "parsed post blocks"],
      "payload_keys": ["rendered", "parsed", "rendered_count", "parsed_count", "total_duration_ms", "dynamic_count"],
      "sensitive_fields": ["rendered", "parsed"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\AssetCollector",
      "key": "assets",
      "priority": 33,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["global wp_scripts", "global wp_styles"],
      "payload_keys": ["scripts", "styles", "missing_dependencies", "duplicate_sources"],
      "sensitive_fields": ["scripts", "styles"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\HttpClientCollector",
      "key": "http_client",
      "priority": 30,
      "views": {"toolbar": "none", "panel": true},
      "sources": ["ProfilerHttpClientRecorder"],
      "payload_keys": ["count", "error_count", "total_duration_ms", "requests"],
      "sensitive_fields": ["requests"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\CacheCollector",
      "key": "cache",
      "priority": 20,
      "views": {"toolbar": "none", "panel": true},
      "sources": ["global wp_object_cache", "WordPress cache functions", "nginx cache globals"],
      "payload_keys": ["backend_class", "persistent", "global_groups", "non_persistent_groups", "cache_entry_count", "groups", "stats", "nginx_cache"],
      "sensitive_fields": ["groups", "nginx_cache"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\OptionsCollector",
      "key": "options",
      "priority": 18,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["WordPress alloptions", "global wpdb transients"],
      "payload_keys": ["autoload_count", "autoload_bytes", "largest_autoloaded", "transients"],
      "sensitive_fields": ["largest_autoloaded.*.name", "transients"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\PluginThemeCollector",
      "key": "plugins",
      "priority": 16,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["WordPress plugin API", "WordPress theme API"],
      "payload_keys": ["active_plugins", "network_plugins", "plugins", "mu_plugins", "dropins", "theme"],
      "sensitive_fields": ["plugins", "mu_plugins", "dropins", "theme"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\CronCollector",
      "key": "cron",
      "priority": 14,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["WordPress cron option; raw arguments are summarized as args_count", "WordPress schedules"],
      "payload_keys": ["events", "event_count", "due_count", "missed_count", "schedules", "doing_cron"],
      "sensitive_fields": ["events.*.hook"]
    },
    {
      "class": "SymPress\\Profiler\\Collector\\KernelCollector",
      "key": "kernel",
      "priority": 10,
      "views": {"toolbar": "always", "panel": true},
      "sources": ["SymPress kernel", "SiteConfig", "WpContext", "PHP runtime", "WordPress runtime"],
      "payload_keys": ["environment", "debug", "script_debug", "wordpress_version", "context", "project_dir", "cache_dir", "php_version", "home_url", "site_url", "app_booted", "container_class", "theme", "locale", "multisite", "included_files_count", "included_files", "bundles", "captured_at"],
      "sensitive_fields": ["project_dir", "cache_dir", "home_url", "site_url", "included_files", "bundles"]
    }
  ]
}
